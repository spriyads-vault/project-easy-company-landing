# Copy to .env.local for development. Never commit real values.

# Supabase project URL for the marketing site's own project (bwwudgddemolosvngxcp), separate from the product
# app's database. Server-only: do not prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://bwwudgddemolosvngxcp.supabase.co

# Supabase service-role key (Project Settings > API > service_role). It bypasses Row Level Security, so it is
# read only by server code (src/lib/supabase/server.ts). Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secret key for the HMAC-SHA256 hash of visitor IPs used for waitlist rate limiting. Raw IPs are never stored.
# Generate with: openssl rand -hex 32
WAITLIST_IP_SALT=

# Homepage v6 (light design). Off by default: the v3 homepage stays. Set to 1 to build the v6 homepage.
NEXT_PUBLIC_FF_HOMEPAGE_V6=0
# Section pages with clean URLs (needs NEXT_PUBLIC_FF_HOMEPAGE_V6 on too)
NEXT_PUBLIC_FF_SECTION_PAGES=0
# One scrolling homepage with clean section URLs (needs NEXT_PUBLIC_FF_HOMEPAGE_V6; overrides SECTION_PAGES)
NEXT_PUBLIC_FF_SCROLL_SECTIONS=0
